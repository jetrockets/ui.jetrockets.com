<% set_meta_tags(
  title: "Uploader - Rails UI Components",
  description: "File field with drag & drop, client-side restrictions and image previews, powered by a headless Uppy core.",
  keywords: "Rails, UI Components, Form Builder, Uploader, File Upload, Uppy, Drag and Drop"
) %>
<% breadcrumb :ui_form_builders_uploader %>

<%= ui.header do %>
  <%= ui.header_heading do %>
    <%= ui.header_title "Uploader" %>
    <%= ui.header_subtitle "File field with drag & drop, client-side restrictions and image previews." %>
  <% end %>
  <%= ui.header_actions do %>
    <%= ui.btn "View on GitHub", url: "https://github.com/jetrockets/ui.jetrockets.com/tree/main/app/components/form_builders/uploader", variant: :secondary, target: "_blank", rel: "noopener noreferrer" %>
  <% end %>
<% end %>

<article class="flex flex-col gap-12">
  <%= render_component_preview("uploader") %>

  <section class="flex flex-col gap-4">
    <h2 class="h3">Usage</h2>
    <%= render_component_usage("uploader") %>
  </section>

  <%= render_props_table("uploader") %>

  <section class="flex flex-col gap-6">
    <h2 class="h3">Examples</h2>
    <%= render_component_examples("uploader") %>
  </section>
</article>
