<!DOCTYPE html>

<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-prefetch" content="false">
    <meta name="turbo-cache-control" content="no-cache">
    <meta name="view-transition" content="same-origin">

    <%= display_meta_tags(default_meta_tags) %>

    <script>
      (function() {
        const theme = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>

    <%= render partial: "layouts/shared/favicons" %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= vite_stylesheet_tag "tailwind", "application" %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag "application", data: { turbo_track: :reload }, async: true %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%= render partial: "layouts/shared/analytics" if Rails.env.production? %>
    <%= yield(:head) %>
  </head>

  <body class="<%= body_classes %>" data-controller="sidebar dialogs highlight">
    <%= render partial: "layouts/shared/navbar" %>
    <div class="body__main body__main-sidebarred">
      <%= render partial: "layouts/shared/sidebar" %>
      <div class="body__content">
        <main class="flex flex-col flex-1">
          <%= yield %>
        </main>
        <%= render partial: "layouts/shared/footer" %>
      </div>
    </div>

    <%= ui.flash %>
    <%= ui.turbo_confirm %>

    <%# Async dialogs (data: { turbo_frame: :dialog }) are opened by adopting this sentinel
        frame into a freshly built <dialog> shell before Turbo navigates it — see
        app/components/ui/dialog/dialogs_controller.js and docs/specs/unified-dialog.md §5.3. %>
    <div id="dialogs" data-dialogs-target="root" data-turbo-permanent data-turbo-cache="false">
      <%= turbo_frame_tag :dialog, data: { dialogs_target: "sentinel" } %>
    </div>

    <%= render partial: "layouts/shared/gtm" if Rails.env.production? %>
  </body>
</html>
